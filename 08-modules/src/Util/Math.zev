module Greeter.Util.Math

// Upper-case = public.
fn Add(a: I32, b: I32) -> I32 {
    a + b
}

fn Clamp(x: I32, lo: I32, hi: I32) -> I32 {
    clamp(x, lo, hi)
}

// Lower-case = private to this module (all files of Greeter.Util.Math can see it).
fn clamp(x: I32, lo: I32, hi: I32) -> I32 {
    if (x < lo) { return lo }
    if (x > hi) { return hi }
    x
}
