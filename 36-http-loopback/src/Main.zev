// An HTTP server and client in one program. The server listens on 127.0.0.1
// port 0 and handles requests in an async task; the client calls it with
// Http.Get, Http.Post and Http.Send.
// Modules: Zevic.Http, Zevic.Async.

module Main

import Zevic.Async
import Zevic.Console
import Zevic.Http

fn Main() {
    let server: Http.Server = Http.Listen("127.0.0.1", 0).Unwrap()
    let base: String = "http://127.0.0.1:${server.Port()}"

    // The handler is a function from a request to a response.
    let serving: Async.Task<Result<Unit, Error>> = async {
        server.Serve((req: Http.Request) => {
            if (req.Path() == "/hello") {
                return Http.Response.Text(200, "hello, query is [${req.Query()}]")
            }
            if (req.Path() == "/echo") {
                mut r: Http.Response = Http.Response.Text(201, "${req.Method} ${req.Body}")
                r.SetHeader("X-Seen", req.Header("x-token").UnwrapOr("none"))
                return r
            }
            Http.Response.Text(404, "no such path ${req.Path()}")
        })
    }

    let r1: Http.Response = Http.Get("${base}/hello?name=zevic").Unwrap()
    Console.Println("GET  ${r1.Status} ${r1.Body} ok=${r1.IsOk()}")

    let r2: Http.Response = Http.Post("${base}/echo", "some data").Unwrap()
    Console.Println("POST ${r2.Status} ${r2.Body}")

    // A request with a method, a header and a body.
    mut req: Http.Request = Http.Request.New("PUT", "${base}/echo")
    req.SetHeader("X-Token", "abc")
    req.SetBody("new data")
    let r3: Http.Response = Http.Send(req).Unwrap()
    Console.Println("PUT  ${r3.Status} ${r3.Body} header=${r3.Header("x-seen").UnwrapOr("?")}")

    // An unknown path is a normal response with status 404, not an error.
    let r4: Http.Response = Http.Get("${base}/missing").Unwrap()
    Console.Println("GET  ${r4.Status} ${r4.Body} ok=${r4.IsOk()}")

    // A server that does not exist is an error.
    match (Http.Get("http://127.0.0.1:1/")) {
        Ok(_) => Console.Println("connected?"),
        Err(e) => Console.Println("refused: ${e.Kind().ToString()}"),
    }

    server.Close()
    match (await serving) {
        Ok(_) => Console.Println("server stopped"),
        Err(e) => Console.Println("server error: ${e.Message()}"),
    }
}
