// A discrete-event simulation: events carry a timestamp and sit in a priority queue (a binary min-heap that
// is written out here), and the loop always pops the earliest one. Handlers may schedule further events.
// The scenario is a small coffee shop: customers arrive, wait for the single barista, and leave.
// Shows: a generic-free heap on a struct array, enums with payloads, and a simulation clock.
// Library: Zevic.Console, Zevic.Text.

module Main

import Zevic.Console
import Zevic.Text

enum Kind {
    Arrive(I64),
    FinishOrder(I64),
}

struct Event {
    At: I64
    Seq: I64
    What: Kind

    fn Init(at: I64, seq: I64, what: Kind) {
        this.At = at
        this.Seq = seq
        this.What = what
    }
}

// Earlier time first; equal times keep insertion order so the output is deterministic.
fn before(a: Event, b: Event) -> Bool {
    if (a.At != b.At) { a.At < b.At } else { a.Seq < b.Seq }
}

class Queue {
    items: Array<Event> = []
    next: I64 = 0

    fn Len() -> I64 { this.items.Len() }

    mut fn Push(at: I64, what: Kind) {
        this.items.Push(Event.New(at, this.next, what))
        this.next = this.next + 1
        mut i: I64 = this.items.Len() - 1
        while (i > 0) {
            let parent: I64 = (i - 1) / 2
            if (!before(this.items[i], this.items[parent])) { break }
            this.items.Swap(i, parent)
            i = parent
        }
    }

    mut fn Pop() -> Event {
        let top: Event = this.items[0]
        let last: Event = this.items.Pop().Unwrap()
        if (this.items.Len() > 0) {
            this.items[0] = last
            mut i: I64 = 0
            while (true) {
                let l: I64 = 2 * i + 1
                let r: I64 = 2 * i + 2
                mut m: I64 = i
                if (l < this.items.Len() && before(this.items[l], this.items[m])) { m = l }
                if (r < this.items.Len() && before(this.items[r], this.items[m])) { m = r }
                if (m == i) { break }
                this.items.Swap(i, m)
                i = m
            }
        }
        top
    }
}

fn clock(t: I64) -> String {
    // Minutes after 08:00.
    let h: I64 = 8 + t / 60
    let m: I64 = t % 60
    "${Text.PadLeft(h.ToString(), 2, '0')}:${Text.PadLeft(m.ToString(), 2, '0')}"
}

fn Main() {
    mut q: Queue = Queue.New()
    // Customers arrive at these minutes; making a drink takes 4 minutes.
    let arrivals: Array<I64> = [0, 1, 2, 3, 12, 13, 30]
    for (i in 0..arrivals.Len()) { q.Push(arrivals[i], Kind.Arrive(i + 1)) }

    mut waiting: Array<I64> = []
    mut busy: Bool = false
    mut served: I64 = 0
    mut longest: I64 = 0
    let arrivedAt: Array<I64> = arrivals

    while (q.Len() > 0) {
        let ev: Event = q.Pop()
        match (ev.What) {
            Kind.Arrive(id) => {
                if (busy) {
                    waiting.Push(id)
                    Console.Println("${clock(ev.At)}  customer ${id} arrives and queues (${waiting.Len()} waiting)")
                } else {
                    busy = true
                    Console.Println("${clock(ev.At)}  customer ${id} arrives, order starts at once")
                    q.Push(ev.At + 4, Kind.FinishOrder(id))
                }
            },
            Kind.FinishOrder(id) => {
                served = served + 1
                let waited: I64 = ev.At - 4 - arrivedAt[id - 1]
                if (waited > longest) { longest = waited }
                Console.Println("${clock(ev.At)}  customer ${id} leaves with a coffee (waited ${waited} min)")
                if (waiting.Len() > 0) {
                    let nextId: I64 = waiting.RemoveAt(0)
                    q.Push(ev.At + 4, Kind.FinishOrder(nextId))
                } else {
                    busy = false
                }
            },
        }
    }
    Console.Println("served ${served} customers, longest wait ${longest} min")
}
