// Channels carry values between async tasks. A producer sends numbers, a pool of
// workers squares them, and the main task collects the results. Close() tells a
// receiver that no more values will come.
// Modules: Zevic.Async.

module Main

import Zevic.Async
import Zevic.Console

fn Main() {
    mut jobs: Async.Channel<I64> = Async.Channel.New(4)
    mut results: Async.Channel<I64> = Async.Channel.New(4)

    // One producer: sends 1..=20, then closes the channel.
    let producer: Async.Task<Unit> = async {
        for (i in 1..=20) {
            jobs.Send(i)
        }
        jobs.Close()
    }

    // Three workers: each takes jobs until the channel is closed and empty.
    mut workers: Array<Async.Task<I64>> = []
    for (w in 0..3) {
        workers.Push(async {
            mut done: I64 = 0
            loop {
                match (jobs.Recv()) {
                    Some(n) => {
                        results.Send(n * n)
                        done += 1
                    },
                    None => break,
                }
            }
            done
        })
    }

    // Close the results channel after all workers are finished.
    let closer: Async.Task<I64> = async {
        mut handled: I64 = 0
        for (t in workers) {
            handled += await t
        }
        results.Close()
        handled
    }

    // The main task collects. Which worker did which job is not fixed, so only
    // order-independent facts are printed.
    mut all: Array<I64> = []
    loop {
        match (results.Recv()) {
            Some(v) => all.Push(v),
            None => break,
        }
    }
    await producer
    Console.Println("jobs handled by workers: ${await closer}")
    Console.Println("results: ${all.Len()}")
    let sorted: Array<I64> = all.Sorted()
    Console.Println("sorted: ${sorted.Map((x: I64) => "${x}").Join(" ")}")
    Console.Println("sum: ${sorted.Reduce(0, (acc: I64, x: I64) => acc + x)}")

    // A closed, empty channel gives None right away.
    Console.Println("closed and empty: ${results.Recv().IsNone()}")
}
